{{template "document-start" .}}
  <main id="main" class="landing not-found" tabindex="-1">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-card glass">
        <p class="not-found-code" aria-hidden="true">404</p>
        <h1 id="page-title">{{label "not_found_title"}}</h1>
        <p class="standfirst">{{label "not_found_message"}}</p>
        <p class="standalone-link"><a href="{{.Site.URL}}">{{label "home"}}</a></p>
      </div>
    </section>
  </main>
{{template "document-end" .}}
