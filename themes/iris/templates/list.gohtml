{{template "document-start" .}}
  <main id="main" class="list" tabindex="-1">
    <header class="list-head">
      <h1>{{.Title}}</h1>
      {{template "dates" .}}
      <div class="prose intro">{{.Body}}</div>
    </header>
    {{template "title-image" .}}
    {{with .Entries}}
    <ul class="stories">
      {{range .}}
      <li class="story{{if .Image}} has-image{{end}}">
        {{template "entry-image" .}}
        <h2><a href="{{.URL}}">{{.Title}}</a></h2>
        {{template "dates" .}}
        {{with .Excerpt}}<p class="excerpt">{{.}}</p>{{end}}
      </li>
      {{end}}
    </ul>
    {{end}}
    {{template "pagination" .}}
  </main>
{{template "document-end" .}}
